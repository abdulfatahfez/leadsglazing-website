---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1">Page <span class="mark">not</span> found</h1>
      <p class="lead">The page you are looking for has moved or does not exist.</p>
      <a class="btn btn-light" href="/">Back to home</a>
    </div>
  </section>
</Base>
<style>
  .nf { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; min-height: 50vh; justify-content: center; }
</style>
