---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import { company, services, projects, process, faqs } from "../data/site.js";
const featured = projects.slice(0, 6);
---
<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg"><Img src="/images/curtain-wall-abuja.jpg" alt="" sizes="100vw" loading="eager" fetchpriority="high" /></div>
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <h1 class="h1"><span class="eyebrow hero-eyebrow">Leads Glazing · Glass & aluminium specialists · Abuja & Bida</span>Premium<br /><span class="mark">Aluminium</span> Solutions</h1>
      <p class="hero-sub">We supply and expertly install premium glass and aluminium systems, so every project meets a high standard of quality, performance and finish.</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="/contact/">Start a project</a>
        <a class="btn btn-outline" href="/projects/">See our work</a>
      </div>
    </div>
  </section>

  <!-- Service ticker -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...services, ...services].map((s) => <span>{s.title}<i>✦</i></span>)}
    </div>
  </div>

  <!-- About -->
  <section class="section">
    <div class="panel-light light about">
      <div class="container">
        <div class="about-top reveal">
          <h2 class="h2 about-title">{company.experienceYears}+ years of<br /><span class="mark">hands-on</span><br />glazing expertise.</h2>
          <p class="lead about-side">Leads Glazing was founded to elevate Nigerian architecture. We deliver windows, doors, facades and interior glass for residential, commercial and institutional clients.</p>
        </div>
        <div class="about-media reveal">
          <div class="about-img-main">
            <Img src="/images/katampe-residence.jpg" alt="Residence in Katampe Extension, Abuja, glazed by Leads Glazing" sizes="(max-width: 900px) 100vw, 55vw" />
            <div class="about-badge">
              <strong>Supply · Fabricate · Install</strong>
              <span>One team from measurement to handover</span>
            </div>
          </div>
          <div class="about-img-side">
            <Img src="/images/katampe-balconies.jpg" alt="Glass balconies and decorative screens, Katampe Extension" sizes="(max-width: 900px) 100vw, 40vw" />
          </div>
        </div>
        <p class="about-caption muted reveal">Katampe Extension, Abuja. Glass balconies, windows and decorative screens.</p>
        <div class="stats reveal">
          <div><strong>{company.experienceYears}+</strong><span>Years of experience</span></div>
          <div><strong>2</strong><span>Offices: Abuja & Bida</span></div>
          <div><strong>{services.length}</strong><span>Core glazing services</span></div>
          <div><strong>3</strong><span>Sectors: homes, offices, institutions</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services list -->
  <section class="section services-sec">
    <div class="container">
      <div class="sec-head reveal">
        <h2 class="h2">Smart solutions<br />for every <span class="mark">project</span></h2>
        <a class="view-all" href="/services/">View all services ↗</a>
      </div>
      <div class="mosaic">
        {services.map((s, i) => (
          <a href={`/services/#${s.slug}`} class={`tile t${i + 1} reveal`}>
            <Img src={s.image} alt={`${s.title} by Leads Glazing`} sizes={i === 0 ? "(max-width: 700px) 100vw, 50vw" : "(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 25vw"} />
            <div class="cap">
              <span class="tnum">{String(i + 1).padStart(2, "0")}</span>
              <strong>{s.title}</strong>
              <span class="more">{s.short}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section process">
    <div class="container">
      <div class="sec-head center reveal">
        <h2 class="h2">Turning ideas<br />into <span class="mark">built</span> success</h2>
      </div>
      <div class="steps">
        {process.map((p) => (
          <div class="step reveal">
            <span class="step-num">{p.step}</span>
            <h3 class="h3">{p.title}</h3>
            <p class="muted">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <div class="sec-head reveal">
        <h2 class="h2">Featured <span class="mark">works</span></h2>
        <a class="view-all" href="/projects/">All projects ↗</a>
      </div>
      <div class="work-grid">
        {featured.map((p, i) => (
          <a href="/projects/" class={`work reveal ${i === 0 ? "work-big" : ""}`}>
            <Img src={p.image} alt={`${p.title}, ${p.location}`} sizes={i === 0 ? "(max-width: 700px) 100vw, 66vw" : "(max-width: 700px) 50vw, 33vw"} />
            <div class="work-info">
              <span class="tag">{p.tag}</span>
              <strong>{p.title}</strong>
              <span>{p.location}{p.year && ` · ${p.year}`}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-sec">
    <div class="container">
      <div class="sec-head reveal">
        <h2 class="h2">Questions,<br /><span class="mark">answered</span></h2>
        <a class="view-all" href="/contact/">Ask us something else ↗</a>
      </div>
      <div class="svc-list">
        {faqs.map((f, i) => (
          <details class="svc reveal" open={i === 0}>
            <summary>
              <span class="num">{String(i + 1).padStart(3, "0")}</span>
              <span class="svc-title faq-q">{f.q}</span>
              <span class="plus" aria-hidden="true"></span>
            </summary>
            <div class="faq-a"><p class="lead">{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  })} />
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 820px); display: grid; place-items: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; transform: scale(1.05); }
  .hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(18,18,18,.55) 0%, rgba(18,18,18,.35) 40%, rgba(18,18,18,.95) 100%); }
  .hero-eyebrow { display: block; margin-bottom: 22px; font-weight: 400; line-height: 1.4; }
  .hero-content { position: relative; text-align: center; padding-top: 80px; padding-bottom: 80px; display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .hero-sub { max-width: 600px; font-size: clamp(16px, 1.5vw, 19px); line-height: 1.6; color: var(--gainsboro); text-wrap: balance; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 6px; }

  .ticker { border-top: 1px solid var(--jungle); border-bottom: 1px solid var(--jungle); overflow: hidden; padding: 28px 0; }
  .ticker-track { display: flex; gap: 48px; width: max-content; animation: ticker 40s linear infinite; }
  .ticker span { font-size: clamp(18px, 2vw, 24px); font-weight: 500; letter-spacing: -0.02em; color: var(--grey); white-space: nowrap; display: inline-flex; align-items: center; gap: 48px; }
  .ticker i { font-style: normal; color: var(--gold); font-size: 14px; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker-track { animation: none; } }

  .about { padding: clamp(56px, 7vw, 88px) 0; }
  .about-top { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: end; }
  .about-side { max-width: 340px; justify-self: end; }
  .about-media { display: grid; grid-template-columns: 1.3fr 1fr; gap: 32px; margin-top: 56px; align-items: end; }
  .about-img-main { position: relative; }
  .about-img-main img, .about-img-side img { border-radius: 10px; width: 100%; object-fit: cover; }
  .about-img-main img { aspect-ratio: 4/5; max-height: 560px; }
  .about-img-side img { aspect-ratio: 4/5; max-height: 420px; }
  .about-badge { position: absolute; left: -24px; bottom: 32px; background: var(--onyx); color: var(--soapstone); padding: 22px 24px; border-radius: 10px; max-width: 260px; display: flex; flex-direction: column; gap: 6px; }
  .about-badge strong { font-size: 20px; letter-spacing: -0.02em; }
  .about-badge span { font-size: 14px; color: var(--grey); }
  .about-caption { margin-top: 16px; font-size: 14px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; border-top: 1px solid var(--gainsboro); margin-top: 56px; padding-top: 40px; }
  .stats div { display: flex; flex-direction: column; gap: 6px; }
  .stats strong { font-size: clamp(36px, 4vw, 48px); font-weight: 600; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .stats span { color: var(--ironside); font-size: 15px; }

  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 48px; flex-wrap: wrap; }
  .sec-head.center { justify-content: center; text-align: center; }
  .view-all { color: var(--gold); font-size: 15px; }

  .svc-list { border-top: 1px solid var(--thunder); }
  .svc { border-bottom: 1px solid var(--thunder); }
  .svc summary { list-style: none; display: grid; grid-template-columns: 80px 1fr 40px; align-items: center; gap: 16px; padding: 32px 8px; cursor: pointer; }
  .svc summary::-webkit-details-marker { display: none; }
  .num { color: var(--grey); font-size: 15px; font-variant-numeric: tabular-nums; }
  .svc-title { font-size: clamp(22px, 2.6vw, 32px); font-weight: 600; letter-spacing: -0.03em; transition: color .2s; }
  .svc summary:hover .svc-title { color: var(--gold); }
  .plus { position: relative; width: 26px; height: 26px; justify-self: end; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 26px; height: 2px; background: currentColor; transform: translate(-50%, -50%); transition: transform .25s; }
  .plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .svc[open] .plus::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-q { font-size: clamp(19px, 2.2vw, 26px); }
  .faq-a { padding: 0 8px 32px 104px; max-width: 900px; }

  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 230px; gap: 14px; }
  .tile { position: relative; overflow: hidden; border-radius: 14px; background: var(--jungle); color: var(--soapstone); min-width: 0; }
  .tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .7s ease; }
  .tile:hover img { transform: scale(1.06); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(18,18,18,0) 40%, rgba(18,18,18,.92)); }
  .cap { position: absolute; left: 18px; right: 18px; bottom: 16px; z-index: 1; display: flex; flex-direction: column; gap: 4px; }
  .tnum { color: var(--gold); font-size: 13px; letter-spacing: .1em; font-variant-numeric: tabular-nums; }
  .cap strong { font-size: clamp(17px, 1.7vw, 22px); letter-spacing: -.02em; line-height: 1.15; }
  .more { font-size: 14px; color: var(--gainsboro); max-height: 0; opacity: 0; overflow: hidden; transition: max-height .4s, opacity .4s; }
  .tile:hover .more, .tile:focus-visible .more { max-height: 60px; opacity: 1; }
  .t1 { grid-column: span 2; grid-row: span 2; }
  .t2, .t5, .t6 { grid-column: span 2; }

  .process { background: var(--jungle); }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .step { border: 1px solid var(--thunder); border-radius: var(--radius); padding: 28px 24px; display: flex; flex-direction: column; gap: 14px; background: var(--onyx); }
  .step-num { width: 48px; height: 48px; border-radius: 50%; background: var(--soapstone); color: var(--onyx); display: grid; place-items: center; font-weight: 600; }
  .step .h3 { font-size: 22px; }

  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .work { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 4/5; background: var(--jungle); }
  .work-big { grid-column: span 2; grid-row: span 2; aspect-ratio: auto; }
  .work img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .work:hover img { transform: scale(1.05); }
  .work-info { position: absolute; left: 12px; right: 12px; bottom: 12px; background: var(--soapstone); color: var(--onyx); border-radius: 8px; padding: 14px 16px; display: flex; flex-direction: column; gap: 2px; font-size: 14px; }
  .work-info strong { font-size: 17px; letter-spacing: -0.02em; }
  .work-info span:last-child { color: var(--ironside); }
  .tag { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); }

  @media (max-width: 1023px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .faq-a { padding-left: 8px; }
  }
  @media (max-width: 809px) {
    .about-top, .about-media { grid-template-columns: 1fr; }
    .about-side { justify-self: start; }
    .about-badge { left: 12px; bottom: 12px; }
    .about-img-side { display: none; }
    .stats { grid-template-columns: 1fr 1fr; }
    .svc summary { grid-template-columns: 40px 1fr 30px; padding: 22px 4px; }
    .mosaic { grid-template-columns: 1fr 1fr; grid-auto-rows: 170px; gap: 10px; }
    .t5, .t6 { grid-column: auto; }
    .more { display: none; }
    .cap { left: 12px; right: 12px; bottom: 12px; }
    .steps { grid-template-columns: 1fr; }
    .work-grid { grid-template-columns: 1fr 1fr; }
    .work-grid { gap: 12px; }
    .work { aspect-ratio: auto; display: flex; flex-direction: column; }
    .work img { height: auto; aspect-ratio: 4/5; }
    .work-big { grid-column: span 2; grid-row: auto; }
    .work-big img { aspect-ratio: 4/3; }
    .work:nth-child(6) { display: none; }
    .work-info { position: static; background: var(--jungle); color: var(--soapstone); border-radius: 0; padding: 12px; font-size: 12px; flex: 1; }
    .work-info strong { font-size: 15px; }
    .work-info span:last-child { color: var(--grey); }
    .tag { font-size: 10px; letter-spacing: .1em; }
  }
</style>
