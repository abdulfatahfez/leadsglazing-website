---
import "../styles/global.css";
import { company, nav, services } from "../data/site.js";
const { title, description = "Leads Glazing supplies and installs aluminium windows and doors, curtain walls, frameless glass partitions and shower glass in Abuja, Bida and across Nigeria. 9+ years' experience.", image = "/og-image.jpg" } = Astro.props;
const fullTitle = title ? `${title} | Leads Glazing` : "Leads Glazing | Aluminium Windows, Curtain Walls & Glass in Abuja";
const site = "https://leadsglazing.com";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": `${site}/#business`,
      name: company.name,
      url: site,
      logo: `${site}/icon-512.png`,
      image: `${site}/images/curtain-wall-abuja.jpg`,
      description: "Supply, fabrication and installation of architectural glass and aluminium systems in Nigeria.",
      telephone: "+234" + company.phone.slice(1),
      email: company.email,
      founder: { "@type": "Person", name: company.ceo, jobTitle: company.ceoTitle },
      sameAs: [company.instagram],
      areaServed: ["Abuja", "Federal Capital Territory", "Niger State", "Nigeria"],
      address: { "@type": "PostalAddress", streetAddress: "Uoo Complex, Jabi", addressLocality: "Abuja", addressRegion: "FCT", addressCountry: "NG" },
      location: company.offices.map((o) => ({ "@type": "Place", name: `Leads Glazing ${o.city} office`, address: { "@type": "PostalAddress", streetAddress: o.address, addressLocality: o.city, addressCountry: "NG" } })),
      hasOfferCatalog: { "@type": "OfferCatalog", name: "Glazing services", itemListElement: services.map((s) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: s.title, description: s.short, url: `${site}/services#${s.slug}` } })) },
    },
    { "@type": "WebSite", "@id": `${site}/#website`, url: site, name: company.name, publisher: { "@id": `${site}/#business` } },
  ],
};
const wa = `https://wa.me/${company.phoneIntl}?text=${encodeURIComponent("Hello Leads Glazing, I'd like a quote for")}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Leads Glazing" />
  <meta property="og:locale" content="en_NG" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  {image === "/og-image.jpg" && <>
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>}
  <meta property="og:image:alt" content="Leads Glazing logo beside a glazed office building in Abuja" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="geo.region" content="NG-FC" />
  <meta name="geo.placename" content="Abuja" />
  <link rel="sitemap" href="/sitemap.xml" />
  {company.verification?.google && <meta name="google-site-verification" content={company.verification.google} />}
  {company.verification?.bing && <meta name="msvalidate.01" content={company.verification.bing} />}
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#121212" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <button class="menu-btn" id="menuOpen" aria-label="Open menu" aria-controls="drawer" aria-expanded="false">
        <span class="ring"><span></span></span>
        <span class="label">Menu</span>
      </button>
      <a class="logo" href="/" aria-label="Leads Glazing home"><img src="/images/logo-gold.png" alt="Leads Glazing" width="420" height="245" /></a>
      <div class="header-right">
        <a class="email" href={`mailto:${company.email}`}>{company.email}</a>
      </div>
    </div>
  </header>

  <div class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer-top">
      <a href="/"><img src="/images/logo-gold.png" alt="Leads Glazing" style="height:52px;width:auto" /></a>
      <button class="drawer-close" id="menuClose" aria-label="Close menu">&times;</button>
    </div>
    <nav>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="drawer-foot">
      <a href={`tel:${company.phone}`}>{company.phone}</a>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={company.instagram} target="_blank" rel="noopener">{company.instagramHandle}</a>
    </div>
  </div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-cta">
        <h2 class="h2">Let’s build <span class="mark">together</span></h2>
        <a class="btn btn-light" href="/contact">Request a quote</a>
      </div>
      <div class="footer-grid">
        <div>
          <h4>Pages</h4>
          <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </div>
        <div>
          <h4>Services</h4>
          <ul>{services.slice(0, 5).map((s) => <li><a href={`/services#${s.slug}`}>{s.title}</a></li>)}</ul>
        </div>
        <div>
          <h4>Offices</h4>
          <ul>{company.offices.map((o) => <li>{o.address}</li>)}</ul>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href={`tel:${company.phone}`}>{company.phone}</a></li>
            <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
            <li><a href={company.instagram} target="_blank" rel="noopener">Instagram {company.instagramHandle}</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="wordmark" aria-hidden="true">Leadsglazing</div>
    <div class="footer-bottom container">
      <span>© {new Date().getFullYear()} Leads Glazing. All rights reserved.</span>
      <span>Abuja · Bida</span>
    </div>
  </footer>

  <a class="wa-float" href={wa} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C9 3 3.3 8.6 3.3 15.6c0 2.2.6 4.4 1.7 6.3L3 29l7.3-1.9c1.8 1 3.8 1.5 5.8 1.5 7 0 12.7-5.7 12.7-12.6S23 3 16 3zm0 23.2c-1.9 0-3.7-.5-5.3-1.4l-.4-.2-4.3 1.1 1.2-4.2-.3-.4c-1-1.7-1.6-3.6-1.6-5.5C5.3 9.8 10.1 5 16 5s10.6 4.8 10.6 10.6S21.9 26.2 16 26.2zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.5-1.6-.9-.8-1.6-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.7 5.8 5.1.8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3z"/></svg>
  </a>

  <script>
    const drawer = document.getElementById("drawer");
    const openBtn = document.getElementById("menuOpen");
    const closeBtn = document.getElementById("menuClose");
    const setOpen = (o) => {
      drawer.classList.toggle("open", o);
      openBtn.setAttribute("aria-expanded", String(o));
      document.body.style.overflow = o ? "hidden" : "";
    };
    openBtn.addEventListener("click", () => setOpen(true));
    closeBtn.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</body>
</html>
